# Rendered by install.sh -> /etc/udev/rules.d/99-immich-usb-backup.rules
# Fires only for the btrfs filesystem whose UUID is USB_UUID in .env.
ACTION=="add", SUBSYSTEM=="block", ENV{ID_FS_UUID}=="@@USB_UUID@@", ENV{ID_FS_TYPE}=="btrfs", TAG+="systemd", ENV{SYSTEMD_WANTS}+="immich-usb-backup.service"
